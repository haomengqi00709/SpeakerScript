# Docker image for RunPod Serverless GPU worker
# Push to Docker Hub or GHCR, then register as a RunPod template.
#
# Build:
#   docker build -f Dockerfile.runpod -t your-user/speakerscript-worker:latest .
#   docker push your-user/speakerscript-worker:latest

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# System deps: Python, ffmpeg, git
RUN apt-get update && apt-get install -y \
    python3 python3-pip ffmpeg git wget sox \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python && ln -sf /usr/bin/pip3 /usr/bin/pip

# Ensure sox binary is on a PATH that pip subprocesses reliably see
RUN ln -sf /usr/bin/sox /usr/local/bin/sox

WORKDIR /app

# PyTorch with CUDA 12.1 (must come before other deps)
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu121

# Install numpy then sox Python package before the rest.
# sox's legacy setup.py needs (a) numpy importable and (b) the sox binary in PATH.
# --no-build-isolation makes the already-installed numpy visible to setup.py.
RUN pip install --no-cache-dir numpy>=1.24.0
RUN pip install --no-cache-dir --no-build-isolation sox

# ML + RunPod deps (sox already satisfied, qwen-asr won't try to rebuild it)
COPY requirements.txt .
RUN pip install --no-cache-dir --no-build-isolation -r requirements.txt
RUN pip install --no-cache-dir runpod requests

# App code
COPY transcriber.py .
COPY runpod_handler.py .

CMD ["python", "runpod_handler.py"]
